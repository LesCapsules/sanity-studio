{
  "name": "sanity-studio",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "package.json",
  "author": "Bruno Alla <alla.brunoo@gmail.com>",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:tsc": "tsc",
    "deploy": "npm run deploy:studio",
    "deploy:studio": "sanity deploy",
    "deploy:graphql": "sanity graphql deploy --force",
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/locale-fr-fr": "^1.2.10",
    "@sanity/vision": "6.11.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "sanity": "6.11.0",
    "sanity-plugin-media": "^6.0.0",
    "styled-components": "6.5.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.15.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "globals": "^17.0.0",
    "prettier": "3.9.6"
  },
  "overrides": {
    "brace-expansion@<2": "^1.1.18",
    "brace-expansion@>=2 <3": "^2.1.4",
    "brace-expansion@>=4": "^5.0.9",
    "js-yaml@<4": "^3.15.0",
    "js-yaml@>=4 <5": "^4.3.0",
    "postcss": "^8.5.25",
    "smol-toml": "^1.6.1",
    "undici@<7": "^6.28.0",
    "undici@>=7 <8": "^7.29.0",
    "uuid@<11": "^11.1.1"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "renovate": {
    "extends": [
      "github>browniebroke/renovate-configs",
      "github>browniebroke/renovate-configs:eslint-prettier"
    ]
  }
}
